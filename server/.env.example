# Copy to server/.env (never commit real values). All settings have safe development defaults.
PARTPILOT_ENV=development                 # development | test | production
DATABASE_URL=postgres://partpilot:CHANGE_ME@localhost:5432/partpilot
TEST_DATABASE_URL=postgres://partpilot:CHANGE_ME@localhost:5432/partpilot_test
PORT=8000
# Production only:
# PARTPILOT_SECRET_KEY=change-me-to-64-random-chars   # required in production (>= 32 chars)
# PARTPILOT_PUBLIC_URL=https://partpilot.example      # used for Origin checks
# PARTPILOT_UPLOAD_DIR=/data/uploads
# PARTPILOT_COOKIE_SECURE=true
# PARTPILOT_TRUST_PROXY=true              # only behind a proxy that overwrites X-Forwarded-For
# PARTPILOT_DEMO_MODE=false
# PARTPILOT_PAYMENTS_TEST_MODE=false      # never true in production
# PARTPILOT_COMMISSION_BPS=800
# PARTPILOT_APP_NAME=PartPilot
