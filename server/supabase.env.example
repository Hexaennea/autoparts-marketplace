# PartPilot settings for a Supabase database.
#
# How to use:
#   1. Rename your current server\.env to server\.env.local (keeps the local setup as a backup).
#   2. Copy this file to server\.env
#   3. Fill in the two values marked FILL below.
#
# Never commit server\.env or share it: it holds your database password.

# ---- Database (Supabase) ---------------------------------------------------------------------
# FILL: Supabase dashboard -> your project -> "Connect" button (top bar) -> "Session pooler".
# Copy that URI and put your database password in place of [YOUR-PASSWORD]. It looks like:
#   postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Use the SESSION pooler (port 5432), not the transaction pooler (port 6543).
# If the password has special characters (@ : / # ? %), set a new one in Supabase
# (Project Settings -> Database -> Reset database password) using only letters and numbers.
DATABASE_URL=

# Encryption to Supabase. "require" works straight away.
# For production, download the CA certificate (Project Settings -> Database -> SSL Configuration),
# save it as server\supabase-ca.crt and change these two lines to:
#   PARTPILOT_DB_SSL=verify
#   PARTPILOT_DB_SSL_CA=supabase-ca.crt
PARTPILOT_DB_SSL=require

# The Supabase free plan allows about 15 connections through the session pooler; stay below it.
PARTPILOT_DB_POOL_MAX=10

# ---- Product photos (Supabase Storage) -------------------------------------------------------
# Leave both empty to keep photos on this computer's disk (var\uploads).
# FILL: Project Settings -> Data API (or API) -> "Project URL", e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# FILL: Project Settings -> API Keys -> "Secret keys" (sb_secret_...) or the legacy "service_role" key.
# Server only. Never put it in the frontend, never share it.
SUPABASE_SECRET_KEY=
# Public bucket that holds product photos.
PARTPILOT_MEDIA_BUCKET=media

# ---- App -------------------------------------------------------------------------------------
PARTPILOT_ENV=development
PARTPILOT_APP_NAME=PartPilot
PARTPILOT_PUBLIC_URL=http://localhost:8000

# FILL: any long random text, at least 32 characters. Required when PARTPILOT_ENV=production.
PARTPILOT_SECRET_KEY=

# Demo sign-in buttons and the test payment gateway. Turn both off before real customers.
PARTPILOT_DEMO_MODE=true
PARTPILOT_PAYMENTS_TEST_MODE=true

# ---- Tests -----------------------------------------------------------------------------------
# The automated tests create and drop whole databases, so they keep using LOCAL PostgreSQL.
# TEST_DATABASE_URL=postgres://partpilot:partpilot@localhost:5432/partpilot_test
