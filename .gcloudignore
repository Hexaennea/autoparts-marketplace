# Files NOT sent to Google Cloud Build. Keys and passwords must never leave this computer this way.
.git/
.gitignore
.gcloudignore
.claude/
.env
.env.*
**/.env
**/.env.*
!.env.example
**/*.crt
**/*.pem
**/*.key
node_modules/
**/node_modules/
frontend/dist/
server/dist/
server/uploads/
var/
e2e/
docs/
backend/
*.db
*.db-wal
*.db-shm

# Android/iOS app project (built separately, see docs/MOBILE-APP.md)
mobile/

# Secret keys (e.g. Firebase service account) must never be committed or deployed
**/service_account*.json
**/*firebase-adminsdk*.json
**/firebase-service-account*.json
