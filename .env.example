# Production settings for docker compose (copy to .env, never commit real values).
# For local development use server/.env (see server/.env.example) instead.
PARTPILOT_ENV=production                  # development | test | production
PARTPILOT_SECRET_KEY=change-me-to-64-random-chars   # required in production (>= 32 chars)
PARTPILOT_PUBLIC_URL=https://partpilot.example      # used for Origin checks
DATABASE_URL=postgres://partpilot:CHANGE_ME@db:5432/partpilot   # docker-compose sets this for its own db
PARTPILOT_UPLOAD_DIR=/data/uploads
PARTPILOT_COOKIE_SECURE=true              # defaults to true in production
PARTPILOT_TRUST_PROXY=true                # only behind a proxy that overwrites X-Forwarded-For
PARTPILOT_DEMO_MODE=false                 # shows the "demo catalogue" strip and demo logins
PARTPILOT_PAYMENTS_TEST_MODE=false        # enables the simulated payment step; never in production
PARTPILOT_COMMISSION_BPS=800              # default commission (8%); admins can change it at runtime
PARTPILOT_APP_NAME=PartPilot
